# Modelo das variáveis de ambiente da Carlos Moto.
#
# Para rodar na sua máquina:  copie para `.env` e preencha.
# Para a Railway:             não suba este arquivo — cadastre cada linha em
#                             Variables, no painel do serviço.
#
# O `.env` de verdade está no .gitignore e nunca vai pro GitHub.

# ---------------------------------------------------------------- obrigatórias

# Banco de dados. Na Railway isto vem pronto: adicione um Postgres ao projeto
# e ligue a variável ao serviço (Variables > Add Reference > DATABASE_URL).
# Aceita o formato que o provedor entrega — `postgresql://…`, com ou sem
# `?sslmode=require`. A conversão pro driver async é feita em app/config.py.
DATABASE_URL=postgresql://usuario:senha@host:5432/carlosmoto

# O segredo que assina os tokens de acesso. Quem tiver este valor consegue
# entrar como dono da loja — trate como a chave do cofre.
# Gere o seu:  python -c "import secrets; print(secrets.token_urlsafe(48))"
CARLOSMOTO_JWT_SEGREDO=troque-isto-por-um-segredo-aleatorio-de-48-caracteres

# ------------------------------------------------------------------ opcionais

# `producao` fecha a documentação da API, liga o HSTS e faz o servidor se
# recusar a subir com o segredo de desenvolvimento.
# O `backend/producao.py` já liga isto sozinho — só está aqui pra constar.
# CARLOSMOTO_AMBIENTE=producao

# A chave de acesso do dono. ESTA VARIÁVEL MANDA: enquanto ela tiver valor, a
# chave do dono é essa — na conta que está nascendo e também numa que já
# exista. É o caminho pra recuperar o acesso quando a chave se perdeu.
# Aceita com traço ou sem, em maiúscula ou minúscula.
# Em branco, o primeiro boot sorteia uma e mostra no log.
#
# O preço: trocar a chave pela tela do sistema não sobrevive ao próximo
# deploy enquanto isto estiver preenchido. Trocou pela tela? Atualize aqui.
# CARLOSMOTO_CHAVE_DONO=ABCD-EFGH-JKMN-PQRS

# Sortear uma chave nova sem escolher qual. Só faz efeito com a
# CARLOSMOTO_CHAVE_DONO vazia. Use, anote a chave do log, e APAGUE esta
# linha — enquanto ela existir, toda subida sorteia outra.
# CARLOSMOTO_REDEFINIR_CHAVE=1

# Fuso da loja. É ele que decide que dia é "hoje" pro vencimento de uma
# parcela e pro fechamento do caixa.
# CARLOSMOTO_FUSO=America/Sao_Paulo

# Quantos erros de chave antes de travar aquele IP, e por quantos segundos.
# CARLOSMOTO_LOGIN_MAX_TENTATIVAS=5
# CARLOSMOTO_LOGIN_BLOQUEIO_SEG=300
